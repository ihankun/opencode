{
  "name": "@anthropic-ai/sandbox-runtime",
  "version": "0.0.64",
  "private": true,
  "description": "Anthropic Sandbox Runtime (ASRT) - A general-purpose tool for wrapping security boundaries around arbitrary processes",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc",
    "build:seccomp": "bun vendor/seccomp/build.ts",
    "build:srt-win": "bun vendor/srt-win/build.ts",
    "clean": "rm -rf dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' --fix --cache --cache-location=node_modules/.cache/.eslintcache",
    "lint:check": "eslint 'src/**/*.ts' --cache --cache-location=node_modules/.cache/.eslintcache",
    "format": "prettier --write 'src/**/*.ts' --cache --log-level warn"
  },
  "dependencies": {
    "@pondwader/socks5-server": "^1.0.10",
    "commander": "^12.1.0",
    "node-forge": "^1.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "@types/node": "^18",
    "@types/node-forge": "^1.3.14",
    "fast-check": "^4.8.0",
    "prettier": "3.3.3",
    "typescript": "^5.6.3"
  },
  "files": [
    "dist",
    "vendor/seccomp",
    "vendor/srt-win",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "sandbox",
    "seatbelt",
    "sandbox-exec",
    "anthropic",
    "claude",
    "security",
    "bubblewrap",
    "network-filtering",
    "filesystem-restrictions"
  ],
  "author": "Anthropic PBC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthropic-experimental/sandbox-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/anthropic-experimental/sandbox-runtime/issues"
  },
  "homepage": "https://github.com/anthropic-experimental/sandbox-runtime#readme",
  "opencodex": {
    "upstreamCommit": "168dd958be371edf4cd883cc0cc3a551524d78d7"
  }
}
